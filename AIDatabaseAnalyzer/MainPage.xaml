<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIDatabaseAnalyzer.ViewModels"
             xmlns:views="clr-namespace:AIDatabaseAnalyzer.Views"
             x:Class="AIDatabaseAnalyzer.MainPage"
             x:DataType="vm:ShellViewModel"
             Title="AI Database Analyzer"
             BackgroundColor="{AppThemeBinding Light={StaticResource WindowBaseLight}, Dark={StaticResource WindowBaseDark}}">

    <Grid>
        <!-- Aurora background: a soft gradient with three glowing blobs behind the glass -->
        <Border StrokeThickness="0"
                Background="{AppThemeBinding Light={StaticResource WindowBgLight}, Dark={StaticResource WindowBgDark}}" />

        <AbsoluteLayout InputTransparent="True" CascadeInputTransparent="True">
            <Border AbsoluteLayout.LayoutBounds="-0.12,-0.25,0.85,1.0" AbsoluteLayout.LayoutFlags="All"
                    StrokeThickness="0"
                    Background="{AppThemeBinding Light={StaticResource BlobBlueLight}, Dark={StaticResource BlobBlueDark}}" />
            <Border AbsoluteLayout.LayoutBounds="1.15,-0.1,0.75,0.95" AbsoluteLayout.LayoutFlags="All"
                    StrokeThickness="0"
                    Background="{AppThemeBinding Light={StaticResource BlobVioletLight}, Dark={StaticResource BlobVioletDark}}" />
            <Border AbsoluteLayout.LayoutBounds="0.55,1.3,0.8,0.9" AbsoluteLayout.LayoutFlags="All"
                    StrokeThickness="0"
                    Background="{AppThemeBinding Light={StaticResource BlobMintLight}, Dark={StaticResource BlobMintDark}}" />
        </AbsoluteLayout>

        <Grid ColumnDefinitions="262,*" ColumnSpacing="6" Padding="14">

            <!-- ============================== Sidebar ============================== -->
            <Border Grid.Column="0" StyleClass="GlassStrong" Padding="16,22,16,16">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4">

                    <HorizontalStackLayout Grid.Row="0" Spacing="12" Padding="6,0,0,18">
                        <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                Background="{StaticResource AccentGradient}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13" />
                            </Border.StrokeShape>
                            <Image Source="logo_glyph.png" WidthRequest="24" HeightRequest="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                            <Label Text="AI Database" StyleClass="Headline" />
                            <Label Text="Analyzer" StyleClass="Caption" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Spacing="4">
                        <Label Text="Workflow" StyleClass="Overline" Margin="14,4,0,6" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding WorkflowItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <Border StyleClass="NavItem" Opacity="1">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.42" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="6">
                                            <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Column="2" Text="{Binding Caption}" StyleClass="Caption" VerticalOptions="Center" FontSize="11.5">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="#CCFFFFFF" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="3" Spacing="4">
                        <BoxView StyleClass="Divider" Margin="8,6,8,10" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding LibraryItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <Border StyleClass="NavItem">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="6">
                                            <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Column="2" Text="{Binding Caption}" StyleClass="Caption" VerticalOptions="Center" FontSize="11.5">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="#CCFFFFFF" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ============================== Content ============================== -->
            <Grid Grid.Column="1">
                <views:ConnectView x:Name="ConnectPanel" IsVisible="{Binding IsConnectVisible}" />
                <views:ScopeView x:Name="ScopePanel" IsVisible="{Binding IsScopeVisible}" />
                <views:InsightsView x:Name="InsightsPanel" IsVisible="{Binding IsInsightsVisible}" />
                <views:AnalysisView x:Name="AnalysisPanel" IsVisible="{Binding IsAnalysisVisible}" />
                <views:ReportsView x:Name="ReportsPanel" IsVisible="{Binding IsReportsVisible}" />
                <views:SettingsView x:Name="SettingsPanel" IsVisible="{Binding IsSettingsVisible}" />
                <views:DiagramView x:Name="DiagramPanel" IsVisible="{Binding IsDiagramVisible}" />
                <views:ChatView x:Name="ChatPanel" IsVisible="{Binding IsChatVisible}" />
                <views:SnapshotsView x:Name="SnapshotsPanel" IsVisible="{Binding IsSnapshotsVisible}" />
            </Grid>
        </Grid>

        <!-- ============================== Toast ============================== -->
        <Border StyleClass="Toast" IsVisible="{Binding IsNoticeVisible}"
                HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,30" MaximumWidthRequest="640">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissNoticeCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="12">
                <Border WidthRequest="10" HeightRequest="10" VerticalOptions="Center" StrokeThickness="0"
                        Background="{StaticResource AccentGradient}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNoticeError}" Value="True">
                            <Setter Property="Background" Value="#E5483E" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNoticeSuccess}" Value="True">
                            <Setter Property="Background" Value="#30B455" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNoticeWarning}" Value="True">
                            <Setter Property="Background" Value="#F59E0B" />
                        </DataTrigger>
                    </Border.Triggers>
                </Border>
                <Label Text="{Binding NoticeText}" FontSize="14" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
