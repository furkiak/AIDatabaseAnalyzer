<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIDatabaseAnalyzer.ViewModels"
             xmlns:ctl="clr-namespace:AIDatabaseAnalyzer.Controls"
             x:Class="AIDatabaseAnalyzer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout x:Name="Column" WidthRequest="700" Spacing="20" Padding="0,30,0,40" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="4">
                <Label Text="Settings" StyleClass="LargeTitle" />
                <Label Text="Choose where the analysis runs and how the app looks." StyleClass="Subtitle" />
            </VerticalStackLayout>

            <!-- ============================ Provider ============================ -->
            <Border StyleClass="Glass">
                <VerticalStackLayout Spacing="16">
                    <Label Text="AI engine" StyleClass="Title" />

                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ProviderTiles}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceTile">
                                <Border StyleClass="Tile" WidthRequest="200" Margin="0,0,10,10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                            <Setter Property="Stroke" Value="{StaticResource Transparent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Caption}" StyleClass="Caption">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#E6FFFFFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="{Binding PrivacyNote}" StyleClass="Body" />

                    <!-- API key -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowApiKey}">
                        <Label Text="{Binding ApiKeyLabel}" StyleClass="FieldLabel" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" StyleClass="Field"><Entry Text="{Binding ApiKey}" IsPassword="{Binding IsKeyHidden}" Placeholder="{Binding ApiKeyPlaceholder}" /></Border>
                            <Button Grid.Column="1" Text="Show / hide" StyleClass="Small" Command="{Binding ToggleKeyVisibilityCommand}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Keys are kept in the system keychain (Keychain on macOS, Credential Locker on Windows), never in plain files." StyleClass="Caption" />
                    </VerticalStackLayout>

                    <!-- Address -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowBaseUrl}">
                        <Label Text="Server address" StyleClass="FieldLabel" />
                        <Border StyleClass="Field"><Entry Text="{Binding BaseUrl}" Placeholder="{Binding BaseUrlPlaceholder}" /></Border>
                    </VerticalStackLayout>

                    <!-- Model and context -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Model" StyleClass="FieldLabel" />
                            <Border StyleClass="Field"><Entry Text="{Binding Model}" Placeholder="{Binding ModelPlaceholder}" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" WidthRequest="160" IsVisible="{Binding ShowContext}">
                            <Label Text="Context (tokens)" StyleClass="FieldLabel" />
                            <Border StyleClass="Field"><Entry Text="{Binding ContextWindow}" Placeholder="32768" Keyboard="Numeric" /></Border>
                        </VerticalStackLayout>
                    </Grid>

                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SuggestedModels}" IsVisible="{Binding HasSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterChip">
                                <Border StyleClass="Pill" Margin="0,0,8,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Text}" StyleClass="Mono" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="A larger context lets a local model read bigger schemas but needs much more memory. 16 384 – 32 768 fits most laptops." StyleClass="Caption" IsVisible="{Binding ShowContext}" />

                    <!-- Parallel requests -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowParallel}">
                        <Label Text="Topics analysed at the same time" StyleClass="FieldLabel" />
                        <ctl:SegmentedControl Items="{Binding ParallelOptions}" SelectedIndex="{Binding ParallelIndex, Mode=TwoWay}" HorizontalOptions="Start" />
                        <Label Text="More parallel requests finish large analyses faster but reach rate limits sooner. Local servers always run one at a time." StyleClass="Caption" />
                    </VerticalStackLayout>

                    <Button Text="{Binding SignupText}" StyleClass="Link" Command="{Binding OpenSignupPageCommand}" IsVisible="{Binding HasSignupLink}" HorizontalOptions="Start" Padding="0" HeightRequest="28" />

                    <Border StyleClass="BannerWarning" IsVisible="{Binding HasSecretsNotice}">
                        <Label Text="{Binding SecretsNotice}" StyleClass="Warning" FontSize="13" />
                    </Border>

                    <!-- Test / models -->
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Test connection" Command="{Binding TestCommand}" />
                        <Button Text="List available models" Command="{Binding RefreshModelsCommand}" />
                        <ActivityIndicator IsRunning="{Binding IsTesting}" IsVisible="{Binding IsTesting}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border StyleClass="BannerSuccess" IsVisible="{Binding TestOk}">
                        <Label Text="{Binding TestMessage}" StyleClass="Success" FontSize="13" />
                    </Border>
                    <Border StyleClass="BannerError" IsVisible="{Binding TestFailed}">
                        <Label Text="{Binding TestMessage}" StyleClass="Danger" FontSize="13" />
                    </Border>

                    <CollectionView ItemsSource="{Binding AvailableModels}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedModel, Mode=TwoWay}" HeightRequest="190"
                                    IsVisible="{Binding HasModels}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StyleClass="Row" Margin="0,1" Padding="12,7">
                                    <Label Text="{Binding .}" StyleClass="Mono" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ============================ Appearance ============================ -->
            <Border StyleClass="Glass">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Appearance" StyleClass="Title" />
                    <ctl:SegmentedControl Items="{Binding Themes}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                    <Label Text="“System” follows your operating system and switches between light and dark automatically." StyleClass="Caption" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================ Privacy ============================ -->
            <Border StyleClass="Glass">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Privacy" StyleClass="Title" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Privacy shield for sample rows" StyleClass="Headline" />
                            <Label Text="Masks e-mail addresses, phone numbers, card numbers, national ids and passwords in the sample rows read from your database (default for new extractions)." StyleClass="Caption" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding MaskSampleData}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding VersionText}" StyleClass="Caption" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Save settings" StyleClass="Primary" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
