<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- A desktop application: macOS (Mac Catalyst) and Windows. -->
		<TargetFrameworks>net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>AIDatabaseAnalyzer</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- The MVVM toolkit hint about WinRT marshalling does not apply to MAUI bindings -->
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

		<!-- Compile bindings that use RelativeSource / Source too (faster and checked at build time) -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>AI Database Analyzer</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.aidatabaseanalyzer</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.2.0</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#5E5CE6" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A0E1B" BaseSize="128,128" />

		<!-- Images (sidebar icons, logo) -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Raw assets: the monospace font used by PDF reports -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- The ER diagram page is embedded so it can be built without any file access -->
		<EmbeddedResource Include="Resources\Web\diagram.html" LogicalName="AIDatabaseAnalyzer.Web.diagram.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Anthropic" Version="12.55.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.20" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
		<PackageReference Include="QuestPDF" Version="2026.9.1" />
	</ItemGroup>

</Project>
