<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <OnPlatform x:Key="MonoFont" x:TypeArguments="x:String">
        <On Platform="WinUI" Value="Consolas" />
        <On Platform="MacCatalyst" Value="Menlo" />
        <On Platform="iOS" Value="Menlo" />
        <On Platform="Android" Value="monospace" />
    </OnPlatform>

    <!-- ================================================================ Labels -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" Class="LargeTitle">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.6" />
    </Style>

    <Style TargetType="Label" Class="Title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
    </Style>

    <Style TargetType="Label" Class="Headline">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" Class="Subtitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="Body">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="Caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="Overline">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="Accent">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" Class="OnAccent">
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
    </Style>

    <Style TargetType="Label" Class="Success">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
    </Style>

    <Style TargetType="Label" Class="Warning">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
    </Style>

    <Style TargetType="Label" Class="Danger">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <Style TargetType="Label" Class="Mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Label" Class="FieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="BigNumber">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
    </Style>

    <!-- ================================================================ Glass containers -->
    <Style TargetType="Border" Class="Glass">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Padding" Value="26" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1B2A55" Offset="0,12" Radius="30" Opacity="0.10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="GlassStrong">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource GlassStrongLight}, Dark={StaticResource GlassStrongDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="30" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1B2A55" Offset="0,14" Radius="34" Opacity="0.13" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="Inset">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InsetFillLight}, Dark={StaticResource InsetFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineBrushLight}, Dark={StaticResource HairlineBrushDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="Field">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource FieldFillLight}, Dark={StaticResource FieldFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FieldStrokeLight}, Dark={StaticResource FieldStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="Pill">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InsetFillLight}, Dark={StaticResource InsetFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineBrushLight}, Dark={StaticResource HairlineBrushDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="PillSelected">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
    </Style>

    <Style TargetType="Border" Class="Row">
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource HoverLight}, Dark={StaticResource HoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="NavItem">
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="21" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource HoverLight}, Dark={StaticResource HoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Banners -->
    <Style TargetType="Border" Class="BannerError">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="BannerWarning">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource WarningSoftLight}, Dark={StaticResource WarningSoftDark}}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="BannerSuccess">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SuccessSoftLight}, Dark={StaticResource SuccessSoftDark}}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="BannerInfo">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InfoSoftLight}, Dark={StaticResource InfoSoftDark}}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control (used by Controls/SegmentedControl) -->
    <Style TargetType="Border" Class="Segmented">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InsetFillLight}, Dark={StaticResource InsetFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineBrushLight}, Dark={StaticResource HairlineBrushDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="Segment">
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="SegmentSelected">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    </Style>

    <Style TargetType="Label" Class="SegmentLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="SegmentLabelSelected">
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
    </Style>

    <!-- Toast -->
    <Style TargetType="Border" Class="Toast">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource GlassStrongLight}, Dark={StaticResource GlassStrongDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1B2A55" Offset="0,10" Radius="26" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Buttons -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource FieldFillLight}, Dark={StaticResource FieldFillDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.86" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.68" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" Class="Primary">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" Class="Danger">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" Class="Link">
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style TargetType="Button" Class="Small">
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- ================================================================ Inputs -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Editor" Class="Mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="BoxView" Class="Divider">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
</ResourceDictionary>
