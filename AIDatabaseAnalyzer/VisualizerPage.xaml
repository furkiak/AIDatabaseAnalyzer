<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIDatabaseAnalyzer.VisualizerPage"
             BackgroundColor="#EEF4FA"
             Shell.PresentationMode="ModalNotAnimated">
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" BackgroundColor="#102E4E" Padding="16" ColumnDefinitions="Auto, *">
            <Button Grid.Column="0" Text="Close" Command="{Binding CloseCommand}"
                    BackgroundColor="#255B8D" TextColor="White" MinimumHeightRequest="44" CornerRadius="11" Padding="14,6" />
            <Label Grid.Column="1" Text="Declared relationship map" VerticalOptions="Center"
                   TextColor="White" FontAttributes="Bold" Margin="15,0,0,0" />
        </Grid>

        <WebView Grid.Row="1"
                 Navigating="OnWebViewNavigating"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <WebView.Source>
                <HtmlWebViewSource Html="{Binding HtmlSource}" />
            </WebView.Source>
        </WebView>
    </Grid>
</ContentPage>
