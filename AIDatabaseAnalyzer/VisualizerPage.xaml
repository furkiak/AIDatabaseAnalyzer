<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AIDatabaseAnalyzer.VisualizerPage" BackgroundColor="{DynamicResource PageColor}" Shell.PresentationMode="ModalNotAnimated">
    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}" Padding="16" Spacing="10">
            <Button Text="Close" Command="{Binding CloseCommand}" BackgroundColor="{DynamicResource InputColor}" TextColor="{DynamicResource TextColor}" MinimumHeightRequest="48" CornerRadius="11" Padding="14,10" />
            <Label Text="Declared relationship map" VerticalOptions="Center" TextColor="{DynamicResource TextColor}" FontAttributes="Bold" Margin="15,0,0,0" LineBreakMode="WordWrap" FontSize="{DynamicResource Font18}" />
        </VerticalStackLayout>
        <WebView Grid.Row="1" Navigating="OnWebViewNavigating" HorizontalOptions="Fill" VerticalOptions="Fill">
            <WebView.Source>
                <HtmlWebViewSource Html="{Binding HtmlSource}" />
            </WebView.Source>
        </WebView>
    </Grid>
</ContentPage>